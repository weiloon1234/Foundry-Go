    "cache": "Existing native warm Go caches; no cold cache created",
    "backend": "Existing local PostgreSQL; private configuration read without disclosure; unique retained schemas; no reset/drop or new database server",
    "verification_environment": {
      "FOUNDRY_TEST_POSTGRES_REQUIRED": "1",
      "FOUNDRY_TEST_GOPLS": "Existing repository bin/gopls",
      "GOWORK": "off",
      "GOFLAGS": "-p=1",
      "GOMEMLIMIT": "4GiB"
    }
  },
  "workload": {
    "model": "Existing generated models.User: 8 persisted columns (UUID, text, integer, nullable text/date/UUID and validated enums), with unloaded relation slots",
    "seed_rows": 1000,
    "order": "Indexed age ascending; age >= 1 and active status; limit 1, 100 or 1000",
    "variants": [
      "Direct database/sql through the same Foundry pgx connector and equivalent concrete codecs",
      "Framework precompiled SQL using the same typed scanner",
      "Freshly built and compiled generated typed ORM query per operation"
    ],
    "pool": "One retained connection per measured pool; same driver statement cache and schema checkout policy",
    "warmup": "Warm buffers and statement cache before each sample",
    "agreement": "Complete generated model equality at all sizes plus exactly one application SELECT per typed list; driver scope checks are separate"
  },
  "changes": [
    "Reduce private sql.Scanner from a full Codec copy to its decoder and typed destination; preserve both-direction declaration validity and publish only after successful decoding",
    "Memoize immutable ordered selections with the existing owned Definition validation check; alias/set/cursor rewriting still copies before mutation",
    "Remove the unused mutation column map from model SELECT compilation",
    "Quote qualified identifiers without Split/temporary slices; share the immutable LIKE escaping grammar through strings.Replacer"
  ],
  "profiling": {
    "compile": "LIKE Replacer building accounted for 28.62% of alloc_space in the baseline mixed compile profile; columnSelections 6.20%, newCompiler 4.88%, and identifier splitting also allocated repeatedly",
    "read": "Result-slice growth and complete model storage dominated the 1000-row allocation profile. Smaller scanner interface boxes save 32 bytes per column",
    "tool": "Bundled native Go pprof source executed with -mod=vendor from the SDK command module; no tool installed",
    "logs": [
      ".cache/orm-performance-20261011/compile-allocation-profile.txt",
      ".cache/orm-performance-20261011/read-allocation-profile.txt"
    ]
  },
