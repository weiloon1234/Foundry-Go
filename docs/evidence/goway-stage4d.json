  "coverage": [
    "14 old/new SQL, binding and hydrated result goldens",
    "parent + per-slot distinct-key batches; no fusion",
    "Load, LoadMissing, loaded zero/NULL, shared/NULL keys, nested aggregates, target/pivot input",
