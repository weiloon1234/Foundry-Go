  "capture_source": "package main\n\nimport (\n \"encoding/json\"\n \"fmt\"\n \"os\"\n \"path/filepath\"\n \"foundry.test/consumer/profiles\"\n \"foundry.test/consumer/articles\"\n \"foundry.test/consumer/passwords\"\n \"foundry.test/consumer/multifactor\"\n \"foundry.test/consumer/idempotenthttp\"\n \"foundry.test/consumer/isolatedhttp\"\n \"foundry.test/consumer/teamworkflow\"\n \"github.com/weiloon1234/Foundry-Go/database/query\"\n \"github.com/weiloon1234/Foundry-Go/extensions\"\n \"github.com/weiloon1234/Foundry-Go/model\"\n)\ntype statement struct { SQL string; Arguments []any }\ntype snapshot struct { Identity json.RawMessage; Statements map[string]statement; Description string; Subject *extensions.Subject }\nfunc must[T any](v T,err error)T{if err!=nil{panic(err)};return v}\nfunc sql(v query.Statement,err error)statement{if err!=nil{panic(err)};return statement{v.SQL(),v.Arguments()}}\nfunc subject(v extensions.Subject)*extensions.Subject{return &v}\nfunc wire(v model.Identity)json.RawMessage{return must(v.MarshalJSON())}\nfunc main(){\n id:=\"018f0000-0000-7000-8000-000000000001\"\n pid:=must(model.ParseID[profiles.Profile](id)); aid:=must(model.ParseID[articles.Article](id))\n owner:=extensions.DefineOwnerWith(\"profiles\",query.IdentityOf(profiles.QueryProfiles().Query,profiles.ProfileFields().ID),extensions.OwnerOptions{StorageModel:\"profiles\"})\n values:=map[string]snapshot{\n \"profiles\":{Identity:wire(must((profiles.Profile{ID:pid}).FoundryReference().Identity())),Statements:map[string]statement{\"read\":sql(profiles.QueryProfiles().Where(profiles.ProfileFields().Name.Eq(\"Consumer\")).Compile()),\"trashed\":sql(profiles.QueryProfiles().WithTrashed().Compile())},Subject:subject(must(owner.Subject(owner.Reference(pid))))},\n \"articles\":{Identity:wire(must((articles.Article{ID:aid}).FoundryReference().Identity())),Statements:map[string]statement{\"read\":sql(articles.QueryArticles().Where(articles.ArticleFields().Slug.Eq(\"welcome\")).Compile())},Description:fmt.Sprintf(\"%#v\",articles.ArticleExtensionDeclaration().Describe()),Subject:subject(must(articles.ArticleExtensionOwner().Subject(articles.ArticleExtensionOwner().Reference(aid))))},\n \"passwords\":{Identity:wire(must((passwords.Account{ID:must(model.ParseID[passwords.Account](id))}).FoundryReference().Identity())),Statements:map[string]statement{\"read\":sql(passwords.QueryPasswordAccounts().Where(passwords.AccountFields().Email.Eq(\"member@example.test\")).Compile())}},\n \"multifactor\":{Identity:wire(must((multifactor.Account{ID:must(model.ParseID[multifactor.Account](id))}).FoundryReference().Identity())),Statements:map[string]statement{\"read\":sql(multifactor.QueryMfaAccounts().Where(multifactor.AccountFields().Email.Eq(\"member@example.test\")).Compile())}},\n \"idempotenthttp\":{Statements:map[string]statement{\"read\":sql(idempotenthttp.QueryIdemWorkspaces().Where(idempotenthttp.WorkspaceFields().Tenant.Eq(\"tenant\")).Compile())}},\n \"isolatedhttp\":{Statements:map[string]statement{\"read\":sql(isolatedhttp.QueryScopeRecords().Where(isolatedhttp.RecordFields().Name.Eq(\"fixture\")).Compile())}},\n \"teamworkflow\":{Statements:map[string]statement{\"read\":sql(teamworkflow.QueryWorkflowProjects().Where(teamworkflow.ProjectFields().Slug.Eq(\"shared\")).Compile())}},\n }\n for name,value:=range values {dir:=filepath.Join(name,\"testdata\");if err:=os.MkdirAll(dir,0755);err!=nil{panic(err)};if err:=os.WriteFile(filepath.Join(dir,\"legacy-model.json\"),must(json.MarshalIndent(value,\"\",\"  \")),0644);err!=nil{panic(err)}}\n}\n",
