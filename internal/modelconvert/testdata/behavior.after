package models

import (
	"github.com/weiloon1234/Foundry-Go/database/orm"
)

// Entry retains its behavior and key capabilities.
//
//foundry:model table=entries var=Entries key=ID retrieval=entryRetrieval scopes=entryScopes identity=false
type Entry struct {
	ID   int64 `foundry:"member=ID,key-role=primary-number"`
	Name string
}

func entryScopes(table EntryTable) []orm.GlobalScope[Entry] { return nil }

func entryRetrieval() orm.RetrievalHooks[Entry] { return orm.RetrievalHooks[Entry]{} }
