package models

import (
 "github.com/weiloon1234/Foundry-Go/database/orm"
 "github.com/weiloon1234/Foundry-Go/database/relation"
)

type Child struct{ID int64}
type Pivot struct{ID int64}

// Parent retains all four relation families.
type Parent struct{
 ID int64
 Child relation.One[Child]
 Children relation.Many[Child]
 Linked relation.Through[Child,Pivot]
 Count relation.Value[int64]
}
type ParentTable struct {
 orm.Table[Parent,int64]
 Child orm.One[Parent,Child]
 Children orm.Many[Parent,Child]
 Linked orm.Through[Parent,Child,Pivot]
 Count orm.Value[Parent,int64]
}
var Parents=orm.Define("parents",func(b orm.Builder[Parent],p *Parent)ParentTable{
 return ParentTable{orm.TableOf(b,&p.ID),orm.OneOf(b,&p.Child),orm.ManyOf(b,&p.Children),orm.ThroughOf(b,&p.Linked),orm.ValueOf(b,&p.Count)}
})

func (p Parent) Label()string{return "parent"}
