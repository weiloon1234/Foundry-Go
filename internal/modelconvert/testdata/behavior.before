package models

import (
 "github.com/weiloon1234/Foundry-Go/database/orm"
)

// Entry retains its behavior and key capabilities.
type Entry struct { ID int64; Name string }
type EntryTable struct { orm.Table[Entry,int64]; Name orm.Text[Entry,string]; ID orm.NumberPrimary[Entry,int64] }
var Entries=orm.Define("entries",func(b orm.Builder[Entry],e *Entry)EntryTable {
 table:=orm.TableOf(b,&e.ID)
 return EntryTable{table,orm.TextOf(b,&e.Name),orm.NumberKey(orm.PrimaryOf(b,table.Key()))}
},orm.WithRetrievalHooks(func()orm.RetrievalHooks[Entry]{return orm.RetrievalHooks[Entry]{}}),orm.WithGlobalScopes(func(table EntryTable)[]orm.GlobalScope[Entry]{return nil}))
