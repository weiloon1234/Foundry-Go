package models
import (
 "github.com/weiloon1234/Foundry-Go/database/orm"
 "github.com/weiloon1234/Foundry-Go/model"
)
type UserTable struct {orm.Table[User, model.ID[User]];Name orm.Text[User,string]}
var Users = orm.Define("users",func(b orm.Builder[User],u *User) UserTable {return UserTable{orm.TableOf(b,&u.ID),orm.TextOf(b,&u.Name)}})
var usersIdentity = orm.IdentityOf(Users.Table,Users.Key())
func (u User) FoundryReference() model.Reference[User,model.ID[User]] {return usersIdentity.ReferenceOf(u)}
func (u User) FoundryIdentity() (model.Identity,error) {return u.FoundryReference().Identity()}
