package models
import (
 "context"
 "github.com/weiloon1234/Foundry-Go/database"
 "github.com/weiloon1234/Foundry-Go/database/orm"
 "github.com/weiloon1234/Foundry-Go/decimal"
 "github.com/weiloon1234/Foundry-Go/temporal"
 "github.com/weiloon1234/Foundry-Go/value"
 "github.com/weiloon1234/Foundry-Go/model"
 "github.com/weiloon1234/Foundry-Go/attachments"
 "github.com/weiloon1234/Foundry-Go/auth/challenge"
 "github.com/weiloon1234/Foundry-Go/database/encrypted"
 "github.com/weiloon1234/Foundry-Go/extensions"
 "github.com/weiloon1234/Foundry-Go/translations"
)

// Amount preserves two decimal capabilities.
type Amount struct { ID int64; USD decimal.Decimal `foundry:"column=amount_usd"`; Budget decimal.Decimal }
type AmountTable struct { orm.Table[Amount,int64]; USD orm.Column[Amount,decimal.Decimal]; Budget orm.Number[Amount,decimal.Decimal] }
var Amounts = orm.Define("amounts",func(b orm.Builder[Amount],m *Amount)AmountTable{return AmountTable{orm.TableOf(b,&m.ID),orm.ColumnOf(b,&m.USD),orm.NumberOf(b,&m.Budget)}})

type Event struct { ID int64; CreatedAt temporal.DateTime; ReopensOn value.Nullable[temporal.Date] }
type EventTable struct {orm.Table[Event,int64];CreatedAt orm.Time[Event,temporal.DateTime];ReopensOn orm.NullableTime[Event,temporal.Date]}
var Events=orm.Define("events",func(b orm.Builder[Event],m *Event)EventTable{return EventTable{orm.TableOf(b,&m.ID),orm.TimeOf(b,&m.CreatedAt),orm.NullableTimeOf(b,&m.ReopensOn)}},orm.NoTimestamps())

type Managed struct { ID int64; CreatedAt temporal.DateTime; UpdatedAt temporal.DateTime; DeletedAt value.Nullable[temporal.DateTime] }
type ManagedTable struct {orm.Table[Managed,int64];CreatedAt orm.CreatedAt[Managed,temporal.DateTime];UpdatedAt orm.UpdatedAt[Managed,temporal.DateTime];DeletedAt orm.SoftDelete[Managed,temporal.DateTime];Soft orm.SoftDeletable[Managed]}
var Manageds=orm.Define("managed",func(b orm.Builder[Managed],m *Managed)ManagedTable{table:=orm.TableOf(b,&m.ID);deleted:=orm.SoftDeleteOf(b,&m.DeletedAt);return ManagedTable{table,orm.CreatedAtOf(b,&m.CreatedAt),orm.UpdatedAtOf(b,&m.UpdatedAt),deleted,orm.SoftDeletes(deleted)}})

type Name struct { ID int64; Normalized string }
func (n Name) MutateNormalized(input string)(string,error){return input,nil}
type NameTable struct {orm.Table[Name,int64];Normalized orm.InputText[Name,string,string]}
var Names=orm.Define("names",func(b orm.Builder[Name],m *Name)NameTable{return NameTable{orm.TableOf(b,&m.ID),orm.InputTextOf[Name,string](b,&m.Normalized,nil)}},orm.WithHooks(nameHooks))
func nameHooks() orm.Hooks[Name] { return orm.Hooks[Name]{} }

type Secret struct { ID model.ID[Secret]; Text encrypted.Text; Payload encrypted.JSON[string]; Maybe value.Nullable[encrypted.Text] }
type SecretTable struct {orm.Table[Secret,model.ID[Secret]];Text orm.Encrypted[Secret,encrypted.Text];Payload orm.Encrypted[Secret,encrypted.JSON[string]];Maybe orm.NullableEncrypted[Secret,encrypted.Text]}
var Secrets=orm.Define("secrets",func(b orm.Builder[Secret],m *Secret)SecretTable{return SecretTable{orm.TableOf(b,&m.ID),orm.EncryptedTextOf(b,&m.Text),orm.EncryptedJSONOf(b,&m.Payload),orm.NullableEncryptedTextOf(b,&m.Maybe)}})

type Alias struct { ID model.ID[Alias]; OriginalID attachments.ID[Alias]; Revision challenge.Revision[Alias] `foundry:"default=database"` }
type AliasTable struct {orm.Table[Alias,model.ID[Alias]];OriginalID orm.Column[Alias,attachments.ID[Alias]];Revision orm.Column[Alias,challenge.Revision[Alias]]}
var Aliases=orm.Define("aliases",func(b orm.Builder[Alias],m *Alias)AliasTable{return AliasTable{orm.TableOf(b,&m.ID),orm.IDOf(b,&m.OriginalID),orm.IDOf(b,&m.Revision)}})

type Page struct { ID int64; Title translations.Text }
type PageTable struct {orm.Table[Page,int64];Title orm.Slot[Page,translations.Text]}
var Pages=orm.Define("pages",func(b orm.Builder[Page],m *Page)PageTable{return PageTable{orm.TableOf(b,&m.ID),orm.SlotOf(b,&m.Title)}},orm.WithHooks(func()orm.Hooks[Page]{
 // Preserve this hook body.
 return orm.Hooks[Page]{Deleting:func(_ context.Context,_ *database.Tx,p Page)error{return nil}}
}))
var PageOwner=extensions.DefineORMOwner("pages",orm.IdentityOf(Pages.Table,Pages.Key()),extensions.OwnerOptions{StorageModel:"old_pages"})
var PageTitle=translations.TextOf(PageOwner,"page-title",translations.Options{},extensions.BindSlot(Pages.Key(),Pages.Title))
