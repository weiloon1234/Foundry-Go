package models

import (
	"context"
	"github.com/weiloon1234/Foundry-Go/attachments"
	"github.com/weiloon1234/Foundry-Go/auth/challenge"
	"github.com/weiloon1234/Foundry-Go/database"
	"github.com/weiloon1234/Foundry-Go/database/encrypted"
	"github.com/weiloon1234/Foundry-Go/database/orm"
	"github.com/weiloon1234/Foundry-Go/decimal"
	"github.com/weiloon1234/Foundry-Go/extensions"
	"github.com/weiloon1234/Foundry-Go/model"
	"github.com/weiloon1234/Foundry-Go/temporal"
	"github.com/weiloon1234/Foundry-Go/translations"
	"github.com/weiloon1234/Foundry-Go/value"
)

// Amount preserves two decimal capabilities.
//
//foundry:model table=amounts var=Amounts key=ID identity=false
type Amount struct {
	ID     int64
	USD    decimal.Decimal `foundry:"column=amount_usd,role=column"`
	Budget decimal.Decimal `foundry:"role=number"`
}

//foundry:model table=events var=Events key=ID timestamps=none identity=false
type Event struct {
	ID        int64
	CreatedAt temporal.DateTime
	ReopensOn value.Nullable[temporal.Date]
}

//foundry:model table=managed var=Manageds key=ID identity=false
type Managed struct {
	ID        int64
	CreatedAt temporal.DateTime                 `foundry:"role=created-at"`
	UpdatedAt temporal.DateTime                 `foundry:"role=updated-at"`
	DeletedAt value.Nullable[temporal.DateTime] `foundry:"role=soft-delete"`
}

//foundry:model table=names var=Names key=ID hooks=nameHooks identity=false
type Name struct {
	ID         int64
	Normalized string `foundry:"input=string"`
}

func (n Name) MutateNormalized(input string) (string, error) { return input, nil }

func nameHooks() orm.Hooks[Name] { return orm.Hooks[Name]{} }

//foundry:model table=secrets var=Secrets key=ID identity=false
type Secret struct {
	ID      model.ID[Secret]
	Text    encrypted.Text
	Payload encrypted.JSON[string]
	Maybe   value.Nullable[encrypted.Text]
}

//foundry:model table=aliases var=Aliases key=ID identity=false
type Alias struct {
	ID         model.ID[Alias]
	OriginalID attachments.ID[Alias]
	Revision   challenge.Revision[Alias] `foundry:"default=database"`
}

//foundry:model table=pages var=Pages key=ID hooks=pageHooks identity=false
type Page struct {
	ID    int64
	Title translations.Text
}

var PageOwner = extensions.DefineORMOwner("pages", orm.IdentityOf(Pages.Table, Pages.Key()), extensions.OwnerOptions{StorageModel: "old_pages"})
var PageTitle = translations.TextOf(PageOwner, "page-title", translations.Options{}, extensions.BindSlot(Pages.Key(), Pages.Title))

func pageHooks() orm.Hooks[Page] {
	// Preserve this hook body.
	return orm.Hooks[Page]{Deleting: func(_ context.Context, _ *database.Tx, p Page) error { return nil }}
}
