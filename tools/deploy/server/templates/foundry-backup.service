# Foundry owned backup
[Unit]
Description=Foundry @TASK@ backup (@IDENTITY@)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I @SCRIPT@ scheduled @TASK@ @IDENTITY@
TimeoutStartSec=7200
KillMode=control-group
