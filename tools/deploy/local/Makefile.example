# Copy these thin entry points into the application's Makefile.
# ENVIRONMENT selects the profile. ACTION selects prepare/inspect/recover for bootstrap,
# build for release, and deploy/status/rollback/restart/stop/down/up/logs/shell/config/
# "keys rotate"/reconcile/report/sync/capacity/tools-plan/tools-apply for deploy.
# Credential replacement: backup-keys-rotate / backup-recipients-rotate / dns-token-rotate.
# Maintenance: ENVIRONMENT=staging ACTION=down CONFIRM=yes make deploy (or ACTION=up).
# down options: MESSAGE / RETRY / ALLOW / EXCEPT / BYPASS=yes; up rejects all of them.
# Logs: make deploy ACTION=logs ROLE=http LINES=500 FOLLOW=yes (Ctrl-C stops streaming).
# LINES defaults to 100, range 1..2000; FOLLOW accepts only yes. Both are logs-only.
# Rollback: make deploy ACTION=rollback TARGET=<release> EXPECTED_CURRENT=<release>
# Resume: add OPERATION=<UUID printed before the original request>.
# Secrets: use the hidden prompts or FOUNDRY_SECRET_<NAME>_FILE paths.
.PHONY: bootstrap deploy release
bootstrap deploy release:
	GOWORK=off go tool foundry deploy --dir "$(CURDIR)" "$@"

# ENVIRONMENT must name an explicit acceptance profile with a host UUID.
# Omit ARCHIVE to build that profile first. No SSH connection is made.
.PHONY: rehearse
rehearse:
	GOWORK=off go tool foundry deploy --dir "$(CURDIR)" rehearse $(if $(ARCHIVE),--archive "$(ARCHIVE)",) --ubuntu "$(or $(UBUNTU),24.04)" $(if $(BINDINGS),--bindings "$(BINDINGS)",)
